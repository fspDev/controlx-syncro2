rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuth() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.rol in ['admin', 'administrativo'];
    }

    // Usuarios: cada uno puede leer y actualizar su propio documento
    match /users/{userId} {
      allow read: if isAuth();
      allow write: if isAuth() && request.auth.uid == userId;
    }

    // Eventos / proyectos
    match /events/{eventId} {
      allow read: if isAuth();
      allow write: if isAuth();
    }

    // Clientes
    match /clientes/{clienteId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // Tareas de usuario — el dueño y los compartidos pueden leer; el dueño puede escribir
    match /tareas_usuario/{tareaId} {
      allow read: if isAuth() && (
        resource.data.userId == request.auth.uid ||
        request.auth.uid in resource.data.get('compartidaCon', [])
      );
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuth() && resource.data.userId == request.auth.uid;
    }

    // Tareas plantilla
    match /tareas_plantilla/{tareaId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // Trabajos externos
    match /trabajos/{trabajoId} {
      allow read: if isAuth();
      allow write: if isAuth();
    }

    // Registros de administración
    match /registrosAdmin/{regId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Planillas gráficas
    match /planillas/{planillaId} {
      allow read: if isAuth();
      allow write: if isAuth();
    }

    // Carpeta base (archivos)
    match /carpetaBase/{docId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // Notificaciones — cada usuario solo accede a las suyas
    match /notifications/{userId}/{document=**} {
      allow read, write: if isAuth() && request.auth.uid == userId;
    }

  }
}
