rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuth() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.rol in ['admin', 'administrativo'];
    }

    // Usuarios — cada uno lee y escribe su propio documento
    match /users/{userId} {
      allow read: if isAuth();
      allow write: if isAuth() && request.auth.uid == userId;
    }

    // Eventos / proyectos
    match /events/{eventId} {
      allow read: if isAuth();
      allow write: if isAuth();
    }

    // Clientes — cualquier usuario autenticado puede crear y editar
    match /clientes/{clienteId} {
      allow read: if isAuth();
      allow write: if isAuth();
    }

    // Trabajos externos
    match /external_jobs/{jobId} {
      allow read: if isAuth();
      allow write: if isAuth();
    }

    // Registros de administración
    match /registros_admin/{regId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Tareas de usuario — el dueño puede escribir; dueño y compartidos pueden leer
    match /tareas_usuario/{tareaId} {
      allow read: if isAuth() && (
        resource.data.userId == request.auth.uid ||
        request.auth.uid in resource.data.get('compartidaCon', [])
      );
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuth() && resource.data.userId == request.auth.uid;
    }

    // Configuración (tareasPlantilla, carpetaBase)
    match /config/{docId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // Planillas gráficas
    match /planillas/{planillaId} {
      allow read: if isAuth();
      allow write: if isAuth();
    }

    // Notificaciones — cada usuario solo accede a las suyas
    match /notifications/{userId}/{document=**} {
      allow read, write: if isAuth() && request.auth.uid == userId;
    }

  }
}
