rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    // Defensivo: `get(...).data.rol` sin default revienta si el doc del
    // usuario todavía no tiene `rol` (p.ej. justo después de crearlo) y
    // deniega el acceso incluso a un admin. `.get('rol', '')` no explota.
    function isAdmin() {
      return isAuth() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('rol', '') in ['admin', 'administrativo'];
    }

    function usuario() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Mismo motivo que isAdmin(): `.get('permisos', {})` con default evita que
    // un usuario cuyo doc todavía no tiene el objeto `permisos` quede
    // bloqueado por una excepción en vez de simplemente no tener el permiso.
    function tieneCtaCteProv() {
      return isAuth() && usuario().get('permisos', {}).get('ctaCteProv', false) == true;
    }

    // Validación de un movimiento de la cta cte de proveedores: montos
    // numéricos no negativos, fecha como string YYYY-MM-DD, largo máximo de
    // servicio, y que el proveedor referenciado exista (o esté sin asignar
    // todavía — una fila recién agregada puede no tener proveedor elegido).
    function movimientoProveedorValido() {
      let d = request.resource.data;
      return d.servicio is string && d.servicio.size() <= 300
        && d.fecha is string && d.fecha.size() == 10
        && d.aPagar is number && d.aPagar >= 0
        && d.pagado is number && d.pagado >= 0
        && d.proveedorId is string
        && (d.proveedorId == '' || exists(/databases/$(database)/documents/proveedores/$(d.proveedorId)));
    }

    // Usuarios — el admin gestiona todo el documento (incluido `permisos`,
    // que es lo que habilita esta y otras features desde el panel). Un
    // usuario NO puede escribir su propio documento salvo dos campos que la
    // app necesita tocar sola (token de push, hora de recordatorio): si
    // pudiera tocar cualquier campo, se auto-tildaría `permisos.ctaCteProv`.
    match /users/{userId} {
      allow read: if isAuth();
      allow write: if isAdmin();
      allow update: if isAuth() && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fcmTokens', 'horaRecordatorio']);
    }

    // Eventos / proyectos
    match /events/{eventId} {
      allow read: if isAuth();
      allow write: if isAuth();
    }

    // Clientes — cualquier usuario autenticado puede crear y editar
    match /clientes/{clienteId} {
      allow read: if isAuth();
      allow write: if isAuth();
    }

    // Trabajos externos
    match /external_jobs/{jobId} {
      allow read: if isAuth();
      allow write: if isAuth();
    }

    // Registros de administración
    match /registros_admin/{regId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Cta Cte Proveedores — el gate real es del lado del servidor: la
    // casilla en el cliente es solo UI, cualquiera con la consola del
    // navegador abierta podría montar el componente igual.
    match /proveedores/{provId} {
      allow read: if tieneCtaCteProv();
      allow create, update: if tieneCtaCteProv()
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0
        && request.resource.data.nombre.size() <= 120
        && request.resource.data.activo is bool;
      // Baja lógica (activo=false) la hace cualquiera con el permiso — el
      // borrado real del documento queda restringido a admin porque
      // dejaría movimientos históricos apuntando a un proveedorId huérfano.
      allow delete: if isAdmin();
    }

    match /movimientos_proveedores/{movId} {
      allow read: if tieneCtaCteProv();
      allow create, update: if tieneCtaCteProv() && movimientoProveedorValido();
      // Borrado: solo quien creó la fila puede eliminarla. Las filas viejas
      // sin `creadoPor` quedan sin dueño y no las borra nadie por esta regla.
      allow delete: if tieneCtaCteProv() && resource.data.get('creadoPor', '') == request.auth.uid;
    }

    // Tareas de usuario — el dueño puede escribir; dueño y compartidos pueden leer
    match /tareas_usuario/{tareaId} {
      allow read: if isAuth() && (
        resource.data.userId == request.auth.uid ||
        request.auth.uid in resource.data.get('compartidaCon', [])
      );
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuth() && resource.data.userId == request.auth.uid;
    }

    // Configuración (tareasPlantilla, carpetaBase)
    match /config/{docId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // Planillas gráficas
    match /planillas/{planillaId} {
      allow read: if isAuth();
      allow write: if isAuth();
    }

    // Notificaciones — cada usuario solo accede a las suyas
    match /notifications/{userId}/{document=**} {
      allow read, write: if isAuth() && request.auth.uid == userId;
    }

  }
}
